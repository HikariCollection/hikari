<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--============-->
    <!-- Base Theme -->
    <!--============-->

    <!--== Theme Base ==-->
    <style name="Base.Theme.Hikari" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disallow "Force dark theme" -->
        <item name="android:forceDarkAllowed" tools:targetApi="Q">false</item>

        <!-- Theme Colors -->
        <item name="colorPrimary">@color/hikari_primary</item>
        <item name="colorOnPrimary">@color/hikari_onPrimary</item>
        <item name="colorPrimaryContainer">@color/hikari_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/hikari_onPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/hikari_inversePrimary</item>
        <item name="colorSecondary">@color/hikari_secondary</item>
        <item name="colorOnSecondary">@color/hikari_onSecondary</item>
        <item name="colorSecondaryContainer">@color/hikari_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/hikari_onSecondaryContainer</item>
        <item name="colorTertiary">@color/hikari_tertiary</item>
        <item name="colorOnTertiary">@color/hikari_onTertiary</item>
        <item name="colorTertiaryContainer">@color/hikari_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/hikari_onTertiaryContainer</item>
        <item name="android:colorBackground">@color/hikari_background</item>
        <item name="colorOnBackground">@color/hikari_onBackground</item>
        <item name="colorSurface">@color/hikari_surface</item>
        <item name="colorOnSurface">@color/hikari_onSurface</item>
        <item name="colorSurfaceVariant">@color/hikari_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/hikari_onSurfaceVariant</item>
        <item name="elevationOverlayColor">@color/hikari_surfaceTint</item>
        <item name="colorSurfaceInverse">@color/hikari_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/hikari_inverseOnSurface</item>
        <item name="colorError">@color/hikari_error</item>
        <item name="colorOnError">@color/hikari_onError</item>
        <item name="colorErrorContainer">@color/hikari_errorContainer</item>
        <item name="colorOnErrorContainer">@color/hikari_onErrorContainer</item>
        <item name="colorOutline">@color/hikari_outline</item>
        <item name="colorOutlineVariant">@color/hikari_outlineVariant</item>
        <item name="colorSurfaceContainer">@color/hikari_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/hikari_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/hikari_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerLow">@color/hikari_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/hikari_surfaceContainerLowest</item>

        <item name="android:divider">@color/divider_default</item>
        <item name="android:listDivider">@drawable/line_divider</item>
        <item name="materialDividerStyle">@style/Widget.Hikari.MaterialDivider</item>

        <!-- Ripples -->
        <item name="colorControlHighlight">?attr/colorSurfaceVariant</item>

        <!-- Handles RTL Text -->
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>

        <!-- Themes -->
        <item name="android:windowLightStatusBar">@bool/lightStatusBar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/amoled_surface</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="o_mr1">@null</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="Q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="Q">false</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Widget.Menu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hikari.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Hikari.MaterialAlertDialog</item>
        <item name="textAppearanceButton">@style/TextAppearance.Widget.Button</item>
        <item name="android:buttonStyle">?attr/borderlessButtonStyle</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionOverflowButtonStyle">@style/Theme.Hikari.ActionButton.Overflow</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="appBarLayoutStyle">@style/Widget.Material3.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar.Surface</item>
        <item name="switchStyle">@style/Widget.Hikari.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
    </style>

    <!--== Default Theme ==-->
    <style name="Theme.Hikari" parent="Base.Theme.Hikari" />

    <!-- Monet theme only support S+ -->
    <style name="Theme.Hikari.Monet" />

    <!--== AMOLED Mode Overlay ==-->
    <style name="ThemeOverlay.Hikari.Amoled" parent="" />

    <!--===============-->
    <!-- Launch Screen -->
    <!--===============-->

    <!--== Splash Theme ==-->
    <style name="Theme.Hikari.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hikari_splash</item>
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Hikari</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
